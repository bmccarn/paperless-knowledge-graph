# Paperless-ngx connection
PAPERLESS_URL=http://your-paperless:8000
PAPERLESS_TOKEN=your-paperless-api-token
PAPERLESS_EXTERNAL_URL=http://your-paperless:8000
PAPERLESS_SKIP_TAG_NAMES=needs-review

# LLM (via LiteLLM proxy or direct)
LITELLM_URL=http://your-litellm:4000
LITELLM_API_KEY=your-litellm-key
GEMINI_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gpt-5.4-mini
STRANDS_ENABLED=true
# Empty inherits GEMINI_MODEL; remove any old explicit override on upgrade.
STRANDS_MODEL=
SOURCE_DATE_ORDER=mdy
ANSWER_AUDIT_TIMEOUT_SECONDS=60
STRANDS_MAX_CONCURRENT_CALLS=4
STRANDS_CALL_TIMEOUT_SECONDS=45

# Frontend server runtime proxy, for both ordinary API calls and streaming
BACKEND_URL=http://app:8000

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large

# Neo4j (runs in Docker, usually no changes needed)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# PostgreSQL/pgvector (runs in Docker, usually no changes needed)
POSTGRES_HOST=pgvector
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_graph
POSTGRES_USER=kguser
POSTGRES_PASSWORD=changeme

# Use memory:// for bounded local caching; Redis outages are treated as misses.
REDIS_URL=redis://redis:6379

# Owner context (used in query system prompts)
OWNER_NAME=Your Name
OWNER_CONTEXT=Brief context about yourself for better query results
